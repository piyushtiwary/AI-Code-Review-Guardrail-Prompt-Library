@@ -9,3 +9,10 @@
 def list_price(record):
     """Return the price in cents, including a valid zero price."""
     return record["cents"]
+
+
+def page_count(records, page_size):
+    """Count nonempty pages for a positive page size."""
+    if page_size <= 0:
+        raise ValueError("page size must be positive")
+    return len(records) // page_size + 1
