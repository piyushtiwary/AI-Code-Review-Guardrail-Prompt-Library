diff --git a/dispatch.py b/dispatch.py
--- a/dispatch.py
+++ b/dispatch.py
@@ -9,3 +9,20 @@
 def notify(send, shipment):
     """Deliver a notice through the supplied transport."""
     send(shipment)
+
+
+def route_summary(stops, depot=None):
+    """Group the route under the assigned depot, defaulting to central."""
+    name = (depot or "").strip() or DEFAULT_DEPOT
+    active = []
+    cancelled = 0
+    for stop in stops:
+        if stop["cancelled"]:
+            cancelled += 1
+        else:
+            active.append(stop["code"])
+    return {
+        "depot": name,
+        "active": active,
+        "cancelled": cancelled,
+    }
