 def notify(send, shipment):
     """Deliver a notice through the supplied transport."""
     send(shipment)
+
+
+def tracking_labels(prefix, first, last):
+    """Build labels for every stop from first through last, inclusive."""
+    if first < 1:
+        raise ValueError("stop numbers start at one")
+    if last < first:
+        return []
+    labels = []
+    width = len(str(last))
+    for stop in range(first, last):
+        number = str(stop).zfill(width)
+        labels.append(f"{prefix}-{number}")
+    return labels
